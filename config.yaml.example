# Copy to config.yaml (gitignored) and fill in real values.
# All feeds share this one listen address/port; a request's own
# username/password (query params or HTTP Basic Auth) picks which feed's
# upstream serves it. Point IPTV apps at either, whichever the app expects —
# both are served by the same feed and credentials, no separate config:
#   M3U:     http://<host>:<listen_port>/playlist.m3u8?username=<username>&password=<password>
#   Xtream:  http://<host>:<listen_port> as the "server", <username>/<password> as the login
#            (the app itself calls /player_api.php, /panel_api.php, and the
#            standard Xtream stream paths against that)
#
# Xtream API support requires upstream_url to be an Xtream get.php URL with
# its own username/password query params (as below) — that pair is also what
# this proxy uses as the upstream's Xtream login for player_api.php/panel_api.php
# calls and for the standard Xtream stream/EPG paths. A feed whose upstream is
# a plain M3U playlist with no such params still works for the M3U routes, but
# has no Xtream login to proxy.
listen_addr: ":58033"

# client_buffer smooths live TS playback by holding every byte read from
# upstream for `duration` before it's written to the client, so a brief
# upstream stall or reconnect that resolves within that window never reaches
# the client as a stall. Applies to every feed's live streams; omit this
# whole section to use the default (enabled, 5s).
client_buffer:
  enabled: true
  duration: 5s

# The /admin page and API (POST /admin/shares mints a temporary, unguessable
# link — GET /share/<token> — to a single channel of a single feed, for
# sending one stream to someone without handing out real feed credentials).
# It is disabled unless admin_allowed_cidrs is set. Pick one way to protect it:
#
# - Behind an authenticating reverse proxy: set trusted_proxies too. /admin/*
#   is then only served to requests that arrived through one of
#   trusted_proxies from a client inside admin_allowed_cidrs, so hitting the
#   listen port directly gets a 403.
# - Without a reverse proxy: set admin_auth, which requires that HTTP Basic
#   login on every /admin/* request, still only from admin_allowed_cidrs. Over
#   plain HTTP the password and share links are unencrypted, so keep this to a
#   network you trust.
#
# trusted_proxies is also the only source of X-Forwarded-* headers this proxy
# believes; they're stripped from every other request.
#
#   curl -X POST https://iptv.example.com/admin/shares \
#     -H "Content-Type: application/json" \
#     -d '{"feed":"feed-1","channel_url":"http://<host>:<listen_port>/live/proxyuser1/proxypass1/12345.ts","ttl":"4h"}'
#
# trusted_proxies:
#   - "172.30.0.0/16" # traefik_internal (docker network inspect traefik_internal)
# admin_allowed_cidrs:
#   - "192.168.1.0/24" # LAN
#   - "172.16.0.0/12" # Docker bridges — LAN clients on the server itself
# admin_auth:
#   username: admin
#   password: change-me

# The host rewritten /stream links point back to is auto-detected from each
# request (Host, or X-Forwarded-Host/-Proto from a trusted_proxies peer such
# as Traefik) — no public_base_url needs configuring. That also means the same
# cached playlist serves correct absolute links to clients reaching this
# proxy through different hostnames (e.g. a LAN address and a public one).
#
# exclude_group_prefixes drops any entry whose group-title starts with one of
# these (case-insensitive) — e.g. an Xtream m3u_plus feed's "Movies: <genre>"
# and "Series: <show>" VOD categories, keeping only live channels. Omit to
# keep everything.
#
# Each feed's username must be unique across the whole file — it's the only
# thing that tells two feeds apart on the shared port.
feeds:
  - name: feed-1
    exclude_group_prefixes: ["movies:", "series:"]
    upstream_url: "http://provider.example.com:8080/get.php?username=UPSTREAM_USER&password=UPSTREAM_PASS&type=m3u_plus&output=ts"
    username: proxyuser1
    password: proxypass1

  - name: feed-2
    exclude_group_prefixes: ["movies:", "series:"]
    upstream_url: "http://provider.example.com:8080/get.php?username=UPSTREAM_USER&password=UPSTREAM_PASS&type=m3u_plus&output=ts"
    username: proxyuser2
    password: proxypass2
