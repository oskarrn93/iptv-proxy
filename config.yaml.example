# Copy to config.yaml (gitignored) and fill in real values.
# All feeds share this one listen address/port; a request's own
# username/password (query params or HTTP Basic Auth) picks which feed's
# upstream serves it. Point IPTV apps at:
#   http://<host>:<listen_port>/playlist.m3u8?username=<username>&password=<password>
listen_addr: ":58033"

# public_base_url should be set to the address IPTV apps actually reach this
# proxy at (listen_addr's public host:port). Rewritten /stream links are
# otherwise served as paths relative to that address, which most players
# reject the whole playlist over since a plain M3U channel list (unlike an
# HLS sub-playlist) has no base URI to resolve a relative entry against.
# exclude_group_prefixes drops any entry whose group-title starts with one of
# these (case-insensitive) — e.g. an Xtream m3u_plus feed's "Movies: <genre>"
# and "Series: <show>" VOD categories, keeping only live channels. Omit to
# keep everything.
#
# Each feed's username must be unique across the whole file — it's the only
# thing that tells two feeds apart on the shared port.
feeds:
  - name: feed-1
    public_base_url: "http://your-host.example.com:58033"
    exclude_group_prefixes: ["movies:", "series:"]
    upstream_url: "http://provider.example.com:8080/get.php?username=UPSTREAM_USER&password=UPSTREAM_PASS&type=m3u_plus&output=ts"
    username: proxyuser1
    password: proxypass1

  - name: feed-2
    public_base_url: "http://your-host.example.com:58033"
    exclude_group_prefixes: ["movies:", "series:"]
    upstream_url: "http://provider.example.com:8080/get.php?username=UPSTREAM_USER&password=UPSTREAM_PASS&type=m3u_plus&output=ts"
    username: proxyuser2
    password: proxypass2
